PORT=5002

MONGO_URI=mongodb://localhost:27017/anilkabadi

JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Optional - used by the backend to build unsubscribe links.
# When unset, emails use http://localhost:5000/api as the API base.
API_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP).
# EMAIL_USER + EMAIL_PASS are required. For a hosted SMTP provider (e.g. Brevo,
# Mailgun, SMTP2GO) also set EMAIL_HOST, EMAIL_PORT and EMAIL_FROM. When no
# EMAIL_HOST is set, Gmail's SMTP service is used. Emails only send when
# EMAIL_USER and EMAIL_PASS are configured; otherwise they are skipped safely.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=AnilKabadi

# Optional secret used to sign unsubscribe links. Defaults to JWT_SECRET.
EMAIL_TOKEN_SECRET=

# Razorpay (Standard Checkout).
# Use TEST mode keys from https://dashboard.razorpay.com/app/keys while developing.
# RAZORPAY_KEY_ID is public and is also returned by the payment APIs.
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are server-only - never expose
# them to the client or prefix them with VITE_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the "Secret" shown under Webhooks in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
