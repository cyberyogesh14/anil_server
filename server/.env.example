# Razorpay (Standard Checkout)
# TEST mode keys. RAZORPAY_KEY_ID is public and is also returned by the payment
# APIs. RAZORPAY_KEY_SECRET is server-only - never expose it to the client or
# prefix it with VITE_. Keep the same KEY_ID in client/.env.
RAZORPAY_KEY_ID=rzp_live_Tw16fFkdB0tfq1
RAZORPAY_KEY_SECRET=2KFXdWm269aGgqi0cvWOM6TR
# Optional. Set the "Secret" shown under Webhooks in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket (Dashboard -> Settings -> API). Use the API user credentials, not
# the normal dashboard login. Both pickup values must be set before live rates
# or shipment creation are enabled; otherwise checkout falls back to Settings.
# Webhook URL: https://<api-domain>/api/shipping/webhook
# Auth: x-shiprocket-webhook-secret: <secret>, or an HMAC-SHA256
# x-shiprocket-signature: sha256=<hex> over the raw body.
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_SHIPPING_MODE=auto
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=20
SHIPROCKET_DEFAULT_BREADTH_CM=15
SHIPROCKET_DEFAULT_HEIGHT_CM=10
SHIPROCKET_AUTO_ASSIGN_AWB=true
SHIPROCKET_AUTO_GENERATE_LABEL=true
SHIPROCKET_AUTO_REQUEST_PICKUP=false
SHIPROCKET_CREATE_LOCK_MS=600000
SHIPPING_RATE_LIMIT_MAX=120
SHIPROCKET_WEBHOOK_RATE_LIMIT_MAX=1000
